# Server
DATABASE_URL=mysql+pymysql://user:pass@localhost:3306/xubio_db
XUBIO_CLIENT_ID=tu_id_cliente_aqui
XUBIO_SECRET_ID=tu_id_secreto_aqui
STATIC_DIR=frontend
FRONTEND_CORS_ORIGINS=http://localhost,http://127.0.0.1,http://127.0.0.1:5173,https://xubio.madygraf.com

# -----------------------------------------------------------------------------
# run.sh - Configuración de Desarrollo (opcional)
# -----------------------------------------------------------------------------

# Puerto donde corre FastAPI (default: 8000)
# FASTAPI_PORT=8000

# Dominio reservado de ngrok (default: confined-unexcused-garland.ngrok-free.dev)
# NGROK_URL=confined-unexcused-garland.ngrok-free.dev

# Archivos PID (default: /tmp/...)
# NGROK_PID_FILE=/tmp/ngrok_calidad_fitba.pid
# FASTAPI_PID_FILE=/tmp/fastapi_calidad_fitba.pid

# Archivos de logs para modo daemon (default: /tmp/...)
# FASTAPI_LOG_FILE=/tmp/fastapi_calidad_fitba.log
# NGROK_LOG_FILE=/tmp/ngrok_output.log

# Path al virtualenv (default: ./venv/bin/activate)
# VENV_PATH=/path/to/venv/bin/activate
